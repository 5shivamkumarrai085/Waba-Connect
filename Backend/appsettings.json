  "ForwardedHeaders": {
    "//": "Which upstream hops may set X-Forwarded-For. Empty means none are trusted, so the forwarded header is ignored entirely and the connection's own address is recorded. Populate KnownProxies with the load balancer's address (or KnownNetworks with its CIDR, e.g. '10.0.0.0/8') in each deployment. Trusting everything would let any caller choose the IP that appears in the audit trail.",
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "//": "Fixed windows, partitioned by user id when signed in and by client IP otherwise. General covers the API; Auth is the tighter bucket on sign-in, which is the endpoint worth guessing at.",
    "Enabled": true,
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60
