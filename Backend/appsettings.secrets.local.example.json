{
  "//": "Template for developer secrets. Copy to appsettings.secrets.local.json (git-ignored) and fill in. Loaded outside Production only; user-secrets and environment variables override it. Use the SAME Encryption:Key as the running system — a different key makes stored credentials unreadable.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require"
  },
  "Auth": {
    "Jwt": {
      "Key": "<at least 32 random characters>"
    },
    "SuperAdmin": {
      "Password": "<first-run admin password>"
    }
  },
  "Encryption": {
    "Key": "<the existing encryption key>"
  },
  "Email": {
    "Tracking": {
      "SigningSecret": "<at least 32 random characters>"
    }
  },
  "Smtp": {
    "Host": "<mail server, e.g. mail.example.com>",
    "Port": 465,
    "Username": "<mailbox user>",
    "Password": "<mailbox password>",
    "FromAddress": "<sender address>",
    "FromName": "OmniConnect",
    "AppBaseUrl": "<frontend URL, e.g. http://localhost:5173>"
  },
  "Groq": {
    "ApiKey": "<optional>"
  }
}
