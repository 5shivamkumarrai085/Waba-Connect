# Environment variables for the Waba-Connect API (ASP.NET Core maps "__" to ":" in configuration).
# Copy the lines you need into your shell, container or hosting settings. Never commit real values.
# For local development you can use Backend/appsettings.secrets.local.json instead (git-ignored).

# ── Platform SMTP (system mail: welcome emails, scheduled reports with no sender chosen) ──
# Port 465 uses implicit TLS; any other port must negotiate STARTTLS. Leave Host empty to turn
# system mail off — the app keeps working and simply sends nothing.
Smtp__Host=mail.rma.my
Smtp__Port=465
Smtp__Username=crm1@rma.my
Smtp__Password=
Smtp__FromAddress=crm1@rma.my
Smtp__FromName=OmniConnect
Smtp__AppBaseUrl=

# Campaign, chat and proof emails do NOT use the settings above: each email connection has its own
# SMTP/IMAP account, entered under Connections › Email and stored encrypted with Encryption__Key.

# ── Required secrets ──
ConnectionStrings__DefaultConnection=
Auth__Jwt__Key=
Encryption__Key=
